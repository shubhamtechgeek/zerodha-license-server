# License Server — Environment Configuration
# Copy this file to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/licenses

# JWT for license activation tokens
LICENSE_JWT_SECRET=change-me-to-a-random-64-char-string
LICENSE_JWT_ALGORITHM=HS256
LICENSE_JWT_EXPIRE_DAYS=30

# Admin panel access
ADMIN_API_KEY=change-me-to-a-random-admin-key
ADMIN_PASSWORD=change-me-to-a-strong-password

# Razorpay (payment gateway) — leave blank to disable
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend.com (email service) — leave blank to disable
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.com

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5000","http://127.0.0.1:5000"]
